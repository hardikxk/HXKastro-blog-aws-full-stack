resource "random_id" "suffix" {
  byte_length = 4
}

# originals/  -> raw uploads from the blog app
# thumbnails/ -> generated by the thumbnail-generator Lambda
resource "aws_s3_bucket" "media" {
  bucket        = "${var.project_name}-media-${random_id.suffix.hex}"
  force_destroy = true

  tags = { Project = var.project_name }
}

resource "aws_s3_bucket_public_access_block" "media" {
  bucket                  = aws_s3_bucket.media.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

# CORS configuration to allow direct browser uploads via presigned URLs
resource "aws_s3_bucket_cors_configuration" "media" {
  bucket = aws_s3_bucket.media.id

  cors_rule {
    allowed_headers = ["*"]
    allowed_methods = ["GET", "PUT", "POST", "HEAD"]
    allowed_origins = ["*"]
    expose_headers  = ["ETag"]
    max_age_seconds = 3000
  }
}
